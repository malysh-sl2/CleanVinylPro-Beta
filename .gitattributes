# Auto detect text files and perform LF normalization
* text=auto

# Windows batch files must reach the PC with CRLF line endings (cmd.exe can lose labels in LF-only files),
# also when the repository is downloaded as a ZIP.
*.bat text eol=crlf
*.cmd text eol=crlf

# Packaged Photoshop plugin (zip container) and the download archive of Clean Vinyl Pro 2
*.ccx binary
*.zip binary

# Clean Vinyl Pro 2: its Windows text files are stored exactly as they must reach the PC (CRLF), with no
# conversion at all - so every way of getting them (archive, single file, clone, download) gives the same bytes.
CleanVinylPro2/*.bat -text
CleanVinylPro2/*.cmd -text
CleanVinylPro2/*.txt -text
CleanVinylPro2/*.ini -text
