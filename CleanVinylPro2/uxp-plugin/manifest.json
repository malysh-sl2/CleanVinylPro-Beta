{
  "id": "com.cleanvinylpro2.photoshop",
  "name": "Чистий Вініл Pro 4.20.0",
  "version": "4.20.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.0.0"
  },
  "manifestVersion": 5,
  "requiredPermissions": {
    "network": {
      "domains": [
        "http://127.0.0.1:18746",
        "http://localhost:18746"
      ]
    },
    "launchProcess": {
      "schemes": [
        "cleanvinyl2"
      ]
    },
    "localFileSystem": "plugin"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "cleanVinylPro2Panel",
      "label": {
        "default": "Чистий Вініл Pro 4.20.0"
      },
      "minimumSize": {
        "width": 250,
        "height": 340
      },
      "maximumSize": {
        "width": 520,
        "height": 1100
      },
      "preferredDockedSize": {
        "width": 290,
        "height": 540
      },
      "preferredFloatingSize": {
        "width": 300,
        "height": 560
      },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/dark.png", "scale": [1, 2], "theme": ["dark", "darkest", "medium"] },
        { "width": 23, "height": 23, "path": "icons/light.png", "scale": [1, 2], "theme": ["light", "lightest"] }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest", "light", "all"],
      "species": ["pluginList"]
    }
  ]
}
